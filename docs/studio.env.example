# Next server; all capabilities stay disabled until isolated QA and configuration.
STUDIO_ENABLED=false
STUDIO_PUBLIC_ENABLED=false
# Client-safe visibility flag for the business sidebar and contextual links.
NEXT_PUBLIC_STUDIO_BUSINESS_ENABLED=false
# Optional comma-separated tenant UUIDs for a private pilot while global visibility stays false.
NEXT_PUBLIC_STUDIO_PILOT_TENANT_IDS=
STUDIO_CHECKOUT_ENABLED=false
STUDIO_AI_ENABLED=false
STUDIO_PUBLISH_ENABLED=false
# Keep payment notifications available even during an operational rollback.
STUDIO_BILLING_WEBHOOK_ENABLED=false
STUDIO_CRON_SECRET=
STUDIO_WORKER_URL=https://PROJECT.supabase.co/functions/v1/studio-worker
STUDIO_WORKER_SECRET=

# Tlaco's billing account, separate from merchant OAuth.
TLACO_MP_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Models are selected only after the benchmark. Do not copy model names blindly.
STUDIO_GEMINI_API_KEY=
STUDIO_GEMINI_IMAGE_MODEL=
STUDIO_GEMINI_REVIEW_MODEL=
OPENAI_API_KEY=
STUDIO_OPENAI_IMAGE_MODEL=
STUDIO_OPENAI_REVIEW_MODEL=
BFL_API_KEY=
STUDIO_FLUX_IMAGE_MODEL=

# Existing Supabase/public app variables are configured by the application.
# Never prefix provider keys or Studio secrets with NEXT_PUBLIC_.
# Edge Function secrets: STUDIO_AI_ENABLED, STUDIO_WORKER_SECRET, provider keys,
# and the same model values used by Next. SUPABASE_* are supplied by Supabase.
